---

<div class="disclaimer-overlay" id="disclaimerOverlay">
  <div class="disclaimer-card">
    <div class="disclaimer-icon">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"/>
        <line x1="12" y1="8" x2="12" y2="12"/>
        <line x1="12" y1="16" x2="12.01" y2="16"/>
      </svg>
    </div>
    <h2>BAFIT Store</h2>
    <p class="disclaimer-text">
      Esta web es un prototipo disenado para <strong>BAFIT Store</strong>,
      sin fines de lucro. Los precios, imagenes y productos son
      ilustrativos y no representan una tienda real.
    </p>
    <div class="disclaimer-brands">
      <span>YoungLA</span>
      <span class="disclaimer-dot"></span>
      <span>Gymshark</span>
      <span class="disclaimer-dot"></span>
      <span>Breathediviny</span>
    </div>
    <button class="disclaimer-btn" id="disclaimerAccept">Aceptar y Continuar</button>
  </div>
</div>

<script is:inline>
  document.getElementById("disclaimerAccept").addEventListener("click", () => {
    document.getElementById("disclaimerOverlay").classList.add("hide");
    setTimeout(() => {
      document.getElementById("disclaimerOverlay").style.display = "none";
    }, 400);
  });
</script>
